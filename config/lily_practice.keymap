#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>


/ {
    combos {
        compatible = "zmk,combos";

        // Clear bluetooth
        combo_bluetooth_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <0 1 6>;
        };
        // arrow up
        combo_arrow_up {
            bindings = <&kp UP>;
            key-positions = <1 7>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // |    &kp A  |  &kp B     |   &kp C   |    H     |     I     |     J     |
            // |    left   |    down    |   right   |    K     |     L     |     M     |
            // |           |            |    mute   |    N     |           |           |

            bindings = <
                &kp A          &kp B         &kp C       &kp H    &kp I    &kp J
                &bt BT_SEL 0   &bt BT_SEL 1  &kp D       &kp K    &kp L    &kp M
                                             &mo 1       &kp N
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer { // Layer 1
            // -------------------------------------
            // |    prev   | play/pause |    next   |    H     |     I     |     J     |
            // |    left   |    down    |   right   |    K     |     L     |     M     |
            // |           |            |    mute   |    N     |           |           |

            bindings = <
                &kp O  &kp UP  &trans    &trans  &trans  &trans 
                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
 };