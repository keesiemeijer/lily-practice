#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>


/ {


    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // |    &kp A  |  &kp B     |   &kp C   |    H     |     I     |     J     |
            // |    left   |    down    |   right   |    K     |     L     |     M     |
            // |           |            |    mute   |    N     |           |           |

            bindings = <
                 &kp A     &kp C_PP      &kp C_NEXT               &kp H    &kp I    &kp J
                 &trans    &trans        &mo 1                    &kp K    &kp L    &kp M
                                         &kp C_MUTE               &kp N
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer { // Layer 1
            // -------------------------------------
            // |    prev   | play/pause |    next   |    H     |     I     |     J     |
            // |    left   |    down    |   right   |    K     |     L     |     M     |
            // |           |            |    mute   |    N     |           |           |

            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 2  &trans    &trans  &trans  &trans 
                &trans        &trans        &trans    &trans  &trans  &trans
                                            &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
 };